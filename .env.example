# Used by docker compose. Copy to .env (in this same folder) and fill in.
# Never commit .env.
# Values: Firebase console -> Project settings -> General -> Your apps -> Web app.
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# The API's service-account key is read from ./secrets/service-account.json.