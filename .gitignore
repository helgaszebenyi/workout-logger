# Secrets: real credentials live here and must never be committed.
# Ignore everything inside the folder, except the placeholder that keeps it in git.
secrets/*
!secrets/.gitkeep

# Safety net: catches a service-account key saved anywhere else by mistake,
# under our name or Firebase's default download name.
*service-account*.json
*firebase-adminsdk*.json

# Dependencies: reinstalled with `npm install`, never committed.
node_modules/

# Local settings: real values, never committed. The .example template is.
.env
!.env.example

# Frontend config: differs per environment (generated inside Docker later).
web/public/config.js

# Vite's production build output: generated by `npm run build`.
dist/