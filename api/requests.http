# Values in {{$dotenv ...}} are read from api/.env, so no secrets live in this file.
@baseUrl = http://localhost:3000
@apiKey = {{$dotenv FIREBASE_WEB_API_KEY}}

### Health check (public, no token needed)
GET {{baseUrl}}/healthz

### Sign up the test user (run once; afterwards it answers EMAIL_EXISTS, which is fine)
POST https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{apiKey}}
Content-Type: application/json

{
  "email": "{{$dotenv TEST_USER_EMAIL}}",
  "password": "{{$dotenv TEST_USER_PASSWORD}}",
  "returnSecureToken": true
}

### Sign in and get an ID token (valid for 1 hour; run again when requests start returning 401)
# @name login
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
  "email": "{{$dotenv TEST_USER_EMAIL}}",
  "password": "{{$dotenv TEST_USER_PASSWORD}}",
  "returnSecureToken": true
}

### Without a token: should return 401
GET {{baseUrl}}/api/workouts

### Create a workout (reps-based and timed sets)
# @name create
POST {{baseUrl}}/api/workouts
Authorization: Bearer {{login.response.body.idToken}}
Content-Type: application/json

{
  "title": "Push day",
  "date": "2026-11-03",
  "exercises": [
    { "name": "Bench press", "sets": [{ "reps": 5, "weightKg": 80 }, { "reps": 5, "weightKg": 80 }] },
    { "name": "Plank", "sets": [{ "durationSec": 60 }, { "durationSec": 45 }] }
  ]
}

### List my workouts
GET {{baseUrl}}/api/workouts
Authorization: Bearer {{login.response.body.idToken}}

### Get the workout created above
GET {{baseUrl}}/api/workouts/{{create.response.body.workout.id}}
Authorization: Bearer {{login.response.body.idToken}}

### Delete it
DELETE {{baseUrl}}/api/workouts/{{create.response.body.workout.id}}
Authorization: Bearer {{login.response.body.idToken}}