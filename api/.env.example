# Copy to .env and fill in. Never commit the real .env.

# Path to the Firebase service-account key, relative to the api/ folder.
GOOGLE_APPLICATION_CREDENTIALS=../secrets/service-account.json

# Only used by requests.http, to sign in a test user and get a token.
# Firebase Web API key: Firebase console -> Project settings -> General.
FIREBASE_WEB_API_KEY=your-web-api-key
# A test account. Any made-up email works; sign it up once with requests.http.
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=choose-a-test-password